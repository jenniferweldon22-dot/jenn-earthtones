# Copy this file to .env and fill in real values. Never commit .env to git.

# Stripe secret key (starts with sk_test_ or sk_live_) — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_) — from your webhook endpoint settings
STRIPE_WEBHOOK_SECRET=

# The public URL of your deployed frontend, used for Stripe redirect URLs
SITE_URL=http://localhost:5173

# Port the backend server runs on
PORT=4242
